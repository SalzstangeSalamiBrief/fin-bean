# Copy this file to backend/.env for reference, then either export these as real
# environment variables or add them to appsettings.Development.json / user-secrets
# before running the API locally. Placeholder values only - never commit real secrets.
# (Plain ASP.NET Core does not load .env files automatically - this file documents
# the variables the app needs; wire them up via environment variables or user-secrets.)

ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL connection (matches docker/.env.template defaults)
ConnectionStrings__FinBeanDb=Host=localhost;Port=5432;Database=finbean;Username=finbean;Password=changeme-local-dev

# Keycloak (matches docker/keycloak/realm-export.json)
Keycloak__Authority=http://localhost:8080/realms/finbean
Keycloak__Audience=finbean-frontend
Keycloak__ClientId=finbean-frontend
Keycloak__MetadataAddress=http://localhost:8080/realms/finbean/.well-known/openid-configuration
